# Google Places API settings for scripts/fetch-reviews.js (optional).
# These are only used at build time (npm run build / npm run fetch-reviews) to refresh
# src/data/reviews.json. They are never sent to the browser.
# If they are missing, the build keeps the reviews already saved in src/data/reviews.json.
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACE_ID=
